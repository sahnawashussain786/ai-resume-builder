# Server
PORT=5000

# MongoDB — local or Atlas
MONGO_URI=mongodb://127.0.0.1:27017/resume-builder

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# AI (optional). Any OpenAI-compatible API works:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1
# Leave AI_API_KEY empty to use the built-in offline fallback generator.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
